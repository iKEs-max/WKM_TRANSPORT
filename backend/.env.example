PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"

JWT_SECRET="generate-a-long-random-secret"
JWT_EXPIRE=7d
FRONTEND_URL="http://localhost:5173"

# SMS Configuration (Optional - fallback to console log)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Mapbox Configuration (Optional - for geocoding if done on backend)
MAPBOX_TOKEN=
SMS_MOBILE_API_KEY=
# Hubtel Payment Configuration
HUBTEL_MERCHANT_ID=
HUBTEL_API_KEY=
HUBTEL_CALLBACK_URL=http://your-api.com/api/v1/webhooks/hubtel
HUBTEL_RETURN_URL=http://your-frontend.com/payment-status

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@wkmtransport.com
