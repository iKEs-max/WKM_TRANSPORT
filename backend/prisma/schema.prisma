generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@map("users")
}

model Route {
  id                String      @id @default(uuid())
  departure         String
  destination       String
  price             Decimal     @db.Decimal(10, 2)
  departureTime     DateTime?
  arrivalTime       DateTime?
  totalSeats        Int
  availableSeats    Int
  status            RouteStatus @default(ACTIVE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  departureTimes    String[]    @default([])
  isPopular         Boolean     @default(false)
  estimatedDuration String?     @default("4h 00min")
  operatingDays     String?     @default("Daily")
  bookings          Booking[]

  @@map("routes")
}

model Booking {
  id              String        @id @default(uuid())
  ticketNumber    String        @unique
  userId          String?
  routeId         String
  numberOfTickets Int
  totalAmount     Decimal       @db.Decimal(10, 2)
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  guestName       String?
  guestPhone      String?
  selectedTime    String?
  route           Route         @relation(fields: [routeId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
  payment         Payment?

  @@map("bookings")
}

model Payment {
  id        String        @id @default(uuid())
  bookingId String        @unique
  amount    Decimal       @db.Decimal(10, 2)
  currency  String        @default("GHS")
  provider  String
  reference String        @unique
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  booking   Booking       @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model GlobalSetting {
  id                       String   @id @default("global_config")
  siteName                 String   @default("Onukpa Express Ride")
  contactEmail             String   @default("support@onukpaexpress.com")
  contactPhone             String?  @default("+233XXXXXXXXX")
  whatsappNumber           String?  @default("+233XXXXXXXXX")
  facebookUrl              String?  @default("https://facebook.com")
  twitterUrl               String?  @default("https://twitter.com")
  instagramUrl             String?  @default("https://instagram.com")
  defaultCurrency          String   @default("GHS")
  paymentProvider          String   @default("paystack")
  maxSeatsPerBooking       Int      @default(10)
  enableEmailNotifications Boolean  @default(true)
  updatedAt                DateTime @updatedAt

  @@map("global_settings")
}

enum Role {
  USER
  ADMIN
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
